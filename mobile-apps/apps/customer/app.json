{
  "expo": {
    "name": "826 Auto Aesthetic",
    "slug": "826-auto",
    "scheme": "aap826",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C0E",
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0B0C0E",
          "imageWidth": 200
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "826 opens your photos so you can send a payment screenshot or add a picture to your review.",
          "cameraPermission": "826 uses the camera so you can take a photo of a payment screenshot or a picture for your review.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2AD3CB"
        }
      ],
      "expo-apple-authentication"
    ],
    "android": {
      "package": "ph.radianceph.aap826",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0F1113",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "ph.radianceph.aap826",
      "buildNumber": "4",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "826 uses the camera so you can take a photo of a payment screenshot or a picture for your review.",
        "NSPhotoLibraryUsageDescription": "826 opens your photos so you can send a payment screenshot or add a picture to your review."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
