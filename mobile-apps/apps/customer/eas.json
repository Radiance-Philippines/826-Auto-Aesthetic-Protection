{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "dev"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dran.dev/demo/826",
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dran.dev/demo/826"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "OWNER_FILLS_AFTER_APP_STORE_CONNECT_RECORD"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
